[Unit]
Description=MeshMine authoritative mainnet CPU, Vulkan GPU, and ASIC miner
After=network-online.target
Wants=network-online.target
Conflicts=meshmine-hsrd-mainnet-canary.service meshmine-hsrd-fast-replay.service

[Service]
Type=simple
ExecStart=%h/.local/libexec/meshmine-minerd --data-dir %h/.local/share/hsrd/mainnet-canary --rpc-bind 127.0.0.1:12047 --rpc-authorization-header-file %h/.config/hsrd/mainnet-canary.authorization --work-state %h/.local/share/meshmine/mainnet-work.redb --gateway-state %h/.local/share/meshmine/mainnet-gateway.redb --gateway-password-file %h/.config/meshmine/mainnet-gateway.password --gateway-username meshmine --gateway-listen 0.0.0.0:3008 --storage-mode pruned --payout-version 0 --payout-hash 803940a709d47ba104a93d0a32e4fb3ca8e15a7f --cpu-threads 3
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/hsrd/mainnet-canary
ReadWritePaths=%h/.local/share/meshmine
ReadOnlyPaths=%h/.local/libexec/meshmine-minerd
ReadOnlyPaths=%h/.config/hsrd/mainnet-canary.authorization
ReadOnlyPaths=%h/.config/meshmine/mainnet-gateway.password

[Install]
WantedBy=default.target
