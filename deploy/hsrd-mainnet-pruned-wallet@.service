[Unit]
Description=hsrd mainnet pruned wallet-index node (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
AssertPathIsMountPoint=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9
AssertPathIsReadWrite=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9

[Service]
Type=simple
WorkingDirectory=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/mainnet-pruned-wallet-v1
ExecStartPre=/usr/bin/sha256sum --check --strict --status /media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/bin/hsrd-%i.sha256
ExecStart=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/bin/hsrd-%i \
  --network mainnet \
  --data-dir /media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/mainnet-pruned-wallet-v1 \
  --rpc-bind 127.0.0.1:12037 \
  --rpc-authorization-header-file /media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/secrets/mainnet-pruned-wallet-v1.authorization \
  --rpc-max-request-bytes 65536 \
  --rpc-max-concurrent-requests 32 \
  --rpc-execution-timeout-ms 5000 \
  --rpc-max-collection-entries 50000 \
  --authority-mode native \
  --storage-durability sync \
  --wallet-index \
  --storage-mode pruned \
  --native-sync \
  --p2p-discovery \
  --maximum-known-addresses 4096 \
  --maximum-inbound 0 \
  --maximum-outbound 8 \
  --active-state-connect-batch 32 \
  --validation-workers 2 \
  --validation-queue 128 \
  --orphan-blocks 1024 \
  --orphan-bytes 67108864 \
  --native-sync-poll-ms 250 \
  --no-hip76-requester \
  --no-odoh-requester \
  --no-hnsr-requester \
  --no-hnsr-relay \
  --log-filter info
Restart=on-failure
RestartSec=10
TimeoutStopSec=600
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/mainnet-pruned-wallet-v1
ReadOnlyPaths=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/bin/hsrd-%i
ReadOnlyPaths=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/bin/hsrd-%i.sha256
ReadOnlyPaths=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/hsrd/secrets/mainnet-pruned-wallet-v1.authorization
InaccessiblePaths=/media/den/64d4d61b-c06f-44ec-9f28-ab6fd78e43f9/Backups
